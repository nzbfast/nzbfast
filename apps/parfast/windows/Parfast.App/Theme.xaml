<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's visual language (plan section 5.7).

  WHAT IS HERE AND WHAT IS NOT. The spacing scale, the radii and the block-state
  palette come from apps/parfast/shared/design/tokens.json through Parfast.Gen,
  and the code-behind reads them from the generated Tokens class. The things that
  cannot be expressed as a token live here: the type ramp, the card and pill
  styles, and the light and dark brush pairs.

  Colours a control DRAWS (the block map's cells, the recovery band) are NOT here.
  They are taken from Tokens at draw time, because the control has to know which
  theme it is in for each cell of a strip that redraws at 10 Hz, and a brush
  lookup per cell would be the slowest thing on the screen.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorder" Color="#E4E4E7" />
            <SolidColorBrush x:Key="SubtleBackground" Color="#F4F4F5" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="#E4E4E7" />
            <SolidColorBrush x:Key="MutedText" Color="#71717A" />
            <SolidColorBrush x:Key="LogBackground" Color="#FAFAFA" />
            <SolidColorBrush x:Key="DropZoneBorder" Color="#A1A1AA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CardBackground" Color="#2B2B2F" />
            <SolidColorBrush x:Key="CardBorder" Color="#3F3F46" />
            <SolidColorBrush x:Key="SubtleBackground" Color="#26262A" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="#3F3F46" />
            <SolidColorBrush x:Key="MutedText" Color="#A1A1AA" />
            <SolidColorBrush x:Key="LogBackground" Color="#1F1F23" />
            <SolidColorBrush x:Key="DropZoneBorder" Color="#71717A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The spacing scale, mirrored from tokens.json so XAML can use it too.
         Parfast.Gen asserts the numbers; these names are what a Margin reads. -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>

    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="PagePadding">24,16,24,16</Thickness>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="SmallRadius">8</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>

    <!-- Segoe UI Variable is the Windows 11 face and falls back to Segoe UI on
         Windows 10. Named explicitly rather than left to the default so the
         figures below can be given tabular digits. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- FIGURES. Plan 5.7 asks for tabular digits, and WinUI 3 EXPOSES NO
         OPENTYPE FEATURE SELECTION on TextBlock: there is no tnum switch to set,
         unlike WPF's Typography attached properties. So the jitter that tnum
         exists to prevent is answered structurally instead - every figure in
         this app is right-aligned inside a fixed-width column (see the four
         tables), so a digit changing width moves nothing to its right. Said here
         because the obvious "fix" is to add a property that does not exist, and
         the second obvious one is to switch this style to the mono family, which
         solves the jitter and makes every size in the app look like code. -->
    <Style x:Key="FigureText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="BigFigureText" TargetType="TextBlock" BasedOn="{StaticResource FigureText}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MutedText}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="GroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MutedCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MutedText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The card: one radius, one border, one padding, used by every screen. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="SubtleCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{ThemeResource SubtleBackground}" />
    </Style>

    <Style x:Key="LogText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="CommandText" TargetType="TextBlock" BasedOn="{StaticResource LogText}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource MutedText}" />
    </Style>

    <!-- A table's header row, so four screens spell it the same way. -->
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MutedText}" />
    </Style>

    <Style x:Key="DropZone" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DropZoneBorder}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="32" />
    </Style>
</ResourceDictionary>
