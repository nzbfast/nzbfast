<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Parfast.App.Views.CreatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Parfast.App.Controls"
    xmlns:vm="using:Parfast.ViewModels"
    xmlns:contracts="using:Parfast.Core.Contracts">

    <Grid>
        <Grid x:Name="EmptyState" Padding="24">
            <Border Style="{StaticResource DropZone}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                    <FontIcon Glyph="&#xE710;" FontSize="42" Opacity="0.55" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" Style="{StaticResource MutedCaption}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="EmptyAddFiles" Style="{StaticResource AccentButtonStyle}" Click="OnAddFiles" />
                        <Button x:Name="EmptyAddFolder" Click="OnAddFolder" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer x:Name="FormView" Visibility="Collapsed" Padding="{StaticResource PagePadding}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Two columns on a wide window: sources left, set right. The
                     VisualStateManager below stacks them under 1000 px. -->
                <Grid x:Name="Columns" Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="*" />
                        <ColumnDefinition x:Name="RightColumn" Width="420" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="260" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="16,12,16,8">
                                <TextBlock x:Name="SourcesHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                    <Button x:Name="AddFiles" Click="OnAddFiles" Padding="10,3,10,3" />
                                    <Button x:Name="AddFolder" Click="OnAddFolder" Padding="10,3,10,3" />
                                    <Button x:Name="RemoveSources" Click="OnRemove" Padding="10,3,10,3" />
                                    <Button x:Name="RefreshSources" Click="OnRefresh" Padding="10,3,10,3" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Padding="16,0,16,8" ColumnSpacing="12"
                                  BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ColName" Grid.Column="0" Style="{StaticResource ColumnHeader}" />
                                <TextBlock x:Name="ColModified" Grid.Column="1" Style="{StaticResource ColumnHeader}" />
                                <TextBlock x:Name="ColSize" Grid.Column="2" Style="{StaticResource ColumnHeader}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <ListView x:Name="SourceList" Grid.Row="2" SelectionMode="Extended"
                                      Padding="8,4,8,8" SelectionChanged="OnSelectionChanged"
                                      ItemContainerTransitions="{x:Null}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SourceRow">
                                        <Grid ColumnSpacing="12" Padding="8,4,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE8B7;" Opacity="0.7"
                                                          Visibility="{x:Bind IsFolder}" />
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Path}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource FigureText}"
                                                       Text="{x:Bind ModifiedText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource FigureText}"
                                                       Text="{x:Bind SizeText}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid Grid.Row="3" Padding="16,8,16,12" ColumnSpacing="12"
                                  BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,1,0,0">
                                <TextBlock x:Name="SourcesFooter" Style="{StaticResource MutedCaption}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <TextBlock x:Name="PathModeLabel" Style="{StaticResource FieldLabel}"
                                               Margin="0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="PathModeBox" MinWidth="190"
                                              SelectionChanged="OnPathModeChanged" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <!-- Source blocks. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="BlocksHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                                <RadioButton x:Name="BlockBySize" GroupName="blocks" Checked="OnBlockModeChanged" />
                                <TextBox x:Name="BlockSizeBox" Margin="28,0,0,0"
                                         LostFocus="OnBlockSizeCommitted" KeyDown="OnBlockSizeKey" />
                                <RadioButton x:Name="BlockByCount" GroupName="blocks" Checked="OnBlockModeChanged" />
                                <NumberBox x:Name="BlockCountBox" Margin="28,0,0,0"
                                           Minimum="1" Maximum="32768" SpinButtonPlacementMode="Compact"
                                           ValueChanged="OnBlockCountChanged" />
                                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="DerivedLabel" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="DerivedValue" Style="{StaticResource FigureText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="PaddingLabel" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="PaddingValue" Style="{StaticResource FigureText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="EfficiencyLabel" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="EfficiencyValue" Style="{StaticResource FigureText}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Recovery. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="RecoveryHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                                <RadioButton x:Name="RecByPercent" GroupName="recovery" Checked="OnRecoveryModeChanged" />
                                <Grid Margin="28,0,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="PercentBox" Grid.Column="0"
                                               Minimum="0" Maximum="1000" SmallChange="1"
                                               SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnPercentChanged" />
                                    <StackPanel x:Name="PercentChips" Grid.Column="1"
                                                Orientation="Horizontal" Spacing="4" />
                                </Grid>
                                <RadioButton x:Name="RecByCount" GroupName="recovery" Checked="OnRecoveryModeChanged" />
                                <NumberBox x:Name="RecCountBox" Margin="28,0,0,0"
                                           Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact"
                                           ValueChanged="OnRecoveryCountChanged" />
                                <RadioButton x:Name="RecBySize" GroupName="recovery" Checked="OnRecoveryModeChanged" />
                                <TextBox x:Name="RecSizeBox" Margin="28,0,0,0" LostFocus="OnRecoverySizeCommitted" />
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock x:Name="DerivedRecoveryLabel" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="DerivedRecoveryValue" Style="{StaticResource FigureText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Output. -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="OutputHeader" Style="{StaticResource GroupHeader}" Margin="0" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" Grid.Column="0" LostFocus="OnOutputCommitted" />
                            <Button x:Name="BrowseOutput" Grid.Column="1" Click="OnBrowseOutput" />
                        </Grid>

                        <Grid x:Name="BasePathRow" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BaseLabel" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Margin="0" VerticalAlignment="Center" />
                            <TextBox x:Name="BaseBox" Grid.Column="1" LostFocus="OnBaseCommitted" />
                            <Button x:Name="BrowseBase" Grid.Column="2" Click="OnBrowseBase" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SchemeLabel" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Margin="0" VerticalAlignment="Center" />
                            <ComboBox x:Name="SchemeBox" Grid.Column="1" MinWidth="320"
                                      HorizontalAlignment="Left" SelectionChanged="OnSchemeChanged" />
                        </Grid>

                        <StackPanel x:Name="UniformPanel" Spacing="8" Margin="0,0,0,0" Visibility="Collapsed">
                            <RadioButton x:Name="UniformFilesRadio" GroupName="uniform" Checked="OnUniformArmChanged" />
                            <NumberBox x:Name="UniformFilesBox" Margin="28,0,0,0" Minimum="1" Maximum="32768"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnUniformChanged" />
                            <RadioButton x:Name="UniformPerFileRadio" GroupName="uniform" Checked="OnUniformArmChanged" />
                            <NumberBox x:Name="UniformPerFileBox" Margin="28,0,0,0" Minimum="1" Maximum="65535"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnUniformChanged" />
                            <RadioButton x:Name="UniformSizeRadio" GroupName="uniform" Checked="OnUniformArmChanged" />
                            <TextBox x:Name="UniformSizeBox" Margin="28,0,0,0" LostFocus="OnUniformSizeCommitted" />
                        </StackPanel>

                        <StackPanel x:Name="Pow2Panel" Spacing="8" Visibility="Collapsed">
                            <RadioButton x:Name="Pow2LargestRadio" GroupName="pow2" Checked="OnPow2ArmChanged" />
                            <RadioButton x:Name="Pow2BlocksRadio" GroupName="pow2" Checked="OnPow2ArmChanged" />
                            <NumberBox x:Name="Pow2BlocksBox" Margin="28,0,0,0" Minimum="1" Maximum="65535"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnPow2Changed" />
                            <RadioButton x:Name="Pow2SizeRadio" GroupName="pow2" Checked="OnPow2ArmChanged" />
                            <TextBox x:Name="Pow2SizeBox" Margin="28,0,0,0" LostFocus="OnPow2SizeCommitted" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FirstBlockLabel" Grid.Column="0" Style="{StaticResource FieldLabel}"
                                       Margin="0" VerticalAlignment="Center" />
                            <NumberBox x:Name="FirstBlockBox" Grid.Column="1" Minimum="0" Maximum="65535"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnFirstBlockChanged" />
                            <TextBlock x:Name="FirstBlockTip" Grid.Column="2" Style="{StaticResource MutedCaption}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBox x:Name="CommentBox" LostFocus="OnCommentCommitted" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="OverwriteBox" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged" />
                            <CheckBox x:Name="StdNamingBox" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged" />
                            <StackPanel x:Name="UnicodeRow" Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="UnicodeLabel" Style="{StaticResource FieldLabel}" Margin="0"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="UnicodeBox" MinWidth="140" SelectionChanged="OnUnicodeChanged" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Preview, open by default. -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Expander x:Name="PreviewExpander" IsExpanded="True" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <Expander.Header>
                            <Grid>
                                <TextBlock x:Name="PreviewHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                                <TextBlock x:Name="PreviewTotal" Style="{StaticResource MutedCaption}"
                                           HorizontalAlignment="Right" Margin="0,0,12,0" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="0,0,0,12">
                            <InfoBar x:Name="WarningBar" IsOpen="False" Severity="Warning" IsClosable="False" />

                            <!-- What this set will cost on disk, ABOVE the per-file
                                 table rather than under it: the proportion is the
                                 answer most people open this card for and the table
                                 is the detail behind it. It collapses itself while
                                 there is no plan. -->
                            <controls:CostBar x:Name="Cost" Margin="4,4,4,8" />

                            <Grid Padding="4,0,4,6" ColumnSpacing="12"
                                  BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PvName" Grid.Column="0" Style="{StaticResource ColumnHeader}" />
                                <TextBlock x:Name="PvSize" Grid.Column="1" Style="{StaticResource ColumnHeader}"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="PvBlocks" Grid.Column="2" Style="{StaticResource ColumnHeader}"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="PvEff" Grid.Column="3" Style="{StaticResource ColumnHeader}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ItemsRepeater x:Name="PreviewList">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:PlannedFile">
                                                <Grid ColumnSpacing="12" Padding="4,3,4,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!-- Function bindings, so the
                                                         preview table formats
                                                         through the same Fmt every
                                                         other figure in the app
                                                         uses rather than showing a
                                                         raw long. -->
                                                    <TextBlock Grid.Column="1" Style="{StaticResource FigureText}"
                                                               Text="{x:Bind vm:Fmt.Bytes(Size)}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource FigureText}"
                                                               Text="{x:Bind vm:Fmt.Count(Blocks)}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource FigureText}"
                                                               Text="{x:Bind vm:Fmt.Pct(EfficiencyPct, 1)}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Action bar. -->
                <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyCommandButton" Click="OnCopyCommand" />
                        <Button x:Name="LogButton" Click="OnToggleLog" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="QueueButton" Click="OnAddToQueue" />
                        <Button x:Name="CreateButton" Style="{StaticResource AccentButtonStyle}" Click="OnCreate" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
