<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Parfast.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Name="PageTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />

            <!-- General -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="GeneralHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="OnOpenLabel" Style="{StaticResource FieldLabel}" />
                        <RadioButton x:Name="OnOpenVerify" GroupName="onopen" Checked="OnOnOpenChanged" />
                        <RadioButton x:Name="OnOpenRepair" GroupName="onopen" Checked="OnOnOpenChanged" />
                    </StackPanel>
                    <CheckBox x:Name="PurgeDefault" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged" />
                    <CheckBox x:Name="KeepDamagedDefault" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged" />
                    <CheckBox x:Name="NotificationsBox" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged" />
                    <CheckBox x:Name="AutoCloseBox" Checked="OnGeneralChanged" Unchecked="OnGeneralChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="LanguageLabel" Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguageBox" MinWidth="180" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Create defaults -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CreateHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="BlockAllocLabel" Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="BlockAllocBox" MinWidth="200" SelectionChanged="OnCreateChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="RecoveryAllocLabel" Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="RecoveryAllocBox" MinWidth="200" SelectionChanged="OnCreateChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="SchemeLabel" Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="SchemeBox" MinWidth="300" SelectionChanged="OnCreateChanged" />
                    </StackPanel>
                    <CheckBox x:Name="StdNamingBox" Checked="OnCreateFlagChanged" Unchecked="OnCreateFlagChanged" />
                    <StackPanel x:Name="UnicodeRow" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="UnicodeLabel" Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="UnicodeBox" MinWidth="140" SelectionChanged="OnCreateChanged" />
                    </StackPanel>
                    <CheckBox x:Name="OverwriteBox" Checked="OnCreateFlagChanged" Unchecked="OnCreateFlagChanged" />
                </StackPanel>
            </Border>

            <!-- Performance -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="PerfHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="AutoThreadsBox" Checked="OnPerfChanged" Unchecked="OnPerfChanged" />
                        <NumberBox x:Name="ThreadsBox" Minimum="0" Maximum="256" Width="130"
                                   SpinButtonPlacementMode="Compact" ValueChanged="OnThreadsChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="MemoryLabel" Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <NumberBox x:Name="MemoryBox" Minimum="0" Maximum="1048576" Width="150"
                                   SpinButtonPlacementMode="Compact" ValueChanged="OnMemoryChanged" />
                        <TextBlock Text="MiB" Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox x:Name="FastSolverBox" Checked="OnPerfChanged" Unchecked="OnPerfChanged" />
                    <CheckBox x:Name="LowPriorityBox" Checked="OnPerfChanged" Unchecked="OnPerfChanged" />
                    <TextBlock x:Name="EngineLine" Style="{StaticResource MutedCaption}" />
                </StackPanel>
            </Border>

            <!-- Integration -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="IntegrationHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                    <TextBlock x:Name="AssocLabel" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <CheckBox x:Name="AssocPar2" Content=".par2" Checked="OnAssocChanged" Unchecked="OnAssocChanged" />
                        <CheckBox x:Name="AssocSfv" Content=".sfv" Checked="OnAssocChanged" Unchecked="OnAssocChanged" />
                        <CheckBox x:Name="AssocMd5" Content=".md5" Checked="OnAssocChanged" Unchecked="OnAssocChanged" />
                        <CheckBox x:Name="AssocSha256" Content=".sha256" Checked="OnAssocChanged" Unchecked="OnAssocChanged" />
                    </StackPanel>
                    <CheckBox x:Name="ContextMenuBox" Checked="OnContextChanged" Unchecked="OnContextChanged" />
                    <TextBlock x:Name="ContextNote" Style="{StaticResource MutedCaption}" Margin="28,0,0,0" />
                    <!-- Two different facts, deliberately two lines: WHO the keys
                         are written for, and WHERE the items turn up. The second
                         is the one that stops a bug report. -->
                    <TextBlock x:Name="Win11Note" Style="{StaticResource MutedCaption}" Margin="28,0,0,0" />
                    <InfoBar x:Name="IntegrationBar" IsOpen="False" Severity="Informational" IsClosable="False" />
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="AdvancedHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                    <CheckBox x:Name="ShowCommandBox" Checked="OnAdvancedChanged" Unchecked="OnAdvancedChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="LogLevelLabel" Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LogLevelBox" MinWidth="150" SelectionChanged="OnAdvancedSelectionChanged" />
                    </StackPanel>
                    <Button x:Name="ResetButton" Click="OnReset" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
