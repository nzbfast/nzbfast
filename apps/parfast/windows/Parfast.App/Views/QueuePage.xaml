<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Parfast.App.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Parfast.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PauseButton" Click="OnPause" />
                <Button x:Name="RunNowButton" Click="OnRunNow" />
                <Button x:Name="CancelButton" Click="OnCancel" />
                <Button x:Name="RemoveButton" Click="OnRemove" />
                <Button x:Name="ClearButton" Click="OnClear" />
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource MutedCaption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Border x:Name="EmptyState" Style="{StaticResource DropZone}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="400">
                    <FontIcon Glyph="&#xE8FD;" FontSize="38" Opacity="0.5" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource SectionTitle}" FontSize="22"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" Style="{StaticResource MutedCaption}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="TableCard" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,12,16,8" ColumnSpacing="12"
                          BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ColKind" Grid.Column="0" Style="{StaticResource ColumnHeader}" />
                        <TextBlock x:Name="ColName" Grid.Column="1" Style="{StaticResource ColumnHeader}" />
                        <TextBlock x:Name="ColStatus" Grid.Column="2" Style="{StaticResource ColumnHeader}" />
                        <TextBlock x:Name="ColProgress" Grid.Column="3" Style="{StaticResource ColumnHeader}" />
                        <TextBlock x:Name="ColAdded" Grid.Column="4" Style="{StaticResource ColumnHeader}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ListView x:Name="RowList" Grid.Row="1" SelectionMode="Extended" Padding="8,4,8,8"
                              SelectionChanged="OnSelectionChanged" ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueRow">
                                <Grid ColumnSpacing="12" Padding="8,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind KindText, Mode=OneWay}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind StatusText, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <ProgressBar Height="4"
                                                     Value="{x:Bind Progress, Mode=OneWay}"
                                                     Maximum="1"
                                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}"
                                                   Style="{StaticResource FigureText}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,-16,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Column="4" Style="{StaticResource FigureText}"
                                               Text="{x:Bind AddedText, Mode=OneWay}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SubtleCard}">
            <Grid ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="ConcurrencyLabel" Style="{StaticResource FieldLabel}" Margin="0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ConcurrencyBox" MinWidth="170" SelectionChanged="OnConcurrencyChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock x:Name="PostLabel" Style="{StaticResource FieldLabel}" Margin="0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="PostBox" MinWidth="160" SelectionChanged="OnPostChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
