<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Parfast.App.Views.ChecksumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Parfast.App.Controls"
    xmlns:vm="using:Parfast.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- The two sub-modes, on a segmented control (plan 5.4). -->
                <SelectorBar x:Name="SubMode" SelectionChanged="OnSubModeChanged">
                    <SelectorBarItem x:Name="TabCreate" IsSelected="True" />
                    <SelectorBarItem x:Name="TabVerify" />
                </SelectorBar>
                <StackPanel x:Name="FormatRow" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="FormatLabel" Style="{StaticResource FieldLabel}" Margin="0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="FormatBox" MinWidth="130" SelectionChanged="OnFormatChanged" />
                </StackPanel>
            </StackPanel>
            <controls:StatusPill x:Name="Summary" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Create sub-mode. -->
        <Grid x:Name="CreateView" Grid.Row="1">
            <Border x:Name="CreateEmpty" Style="{StaticResource DropZone}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
                    <FontIcon Glyph="&#xE9D9;" FontSize="42" Opacity="0.55" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" Style="{StaticResource MutedCaption}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="EmptyAddFiles" Style="{StaticResource AccentButtonStyle}" Click="OnAddFiles" />
                        <Button x:Name="EmptyAddFolder" Click="OnAddFolder" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="CreateCard" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,12,16,8"
                          BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="SourcesHeader" Style="{StaticResource GroupHeader}" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <Button x:Name="AddFiles" Click="OnAddFiles" Padding="10,3,10,3" />
                            <Button x:Name="AddFolder" Click="OnAddFolder" Padding="10,3,10,3" />
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="SourceList" Grid.Row="1" Padding="8,4,8,8"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceRow">
                                <Grid ColumnSpacing="12" Padding="8,4,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Path}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource FigureText}"
                                               Text="{x:Bind SizeText}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Padding="16,10,16,12" Spacing="10"
                                BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" Grid.Column="0" LostFocus="OnOutputCommitted" />
                            <Button x:Name="BrowseOutput" Grid.Column="1" Click="OnBrowseOutput" />
                        </Grid>
                        <CheckBox x:Name="RelativeBox" Checked="OnRelativeChanged" Unchecked="OnRelativeChanged" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Verify sub-mode. -->
        <Grid x:Name="VerifyView" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- A simple pass or fail bar instead of the block map (plan 5.4). -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FileLabel" Style="{StaticResource ColumnHeader}" />
                    <ProgressBar x:Name="PassBar" Height="10" Maximum="1" CornerRadius="5" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,12,16,8" ColumnSpacing="12"
                          BorderBrush="{ThemeResource SeparatorBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ColName" Grid.Column="0" Style="{StaticResource ColumnHeader}" />
                        <TextBlock x:Name="ColExpected" Grid.Column="1" Style="{StaticResource ColumnHeader}" />
                        <TextBlock x:Name="ColStatus" Grid.Column="2" Style="{StaticResource ColumnHeader}" />
                    </Grid>

                    <!-- Shown instead of an empty table when the engine reports
                         totals only. An empty table reads as a RESULT - that
                         nothing was checked - rather than as a missing
                         capability. -->
                    <InfoBar x:Name="NoDetailBar" Grid.Row="1" IsOpen="False"
                             Severity="Informational" IsClosable="False"
                             VerticalAlignment="Top" Margin="16,8,16,8" />

                    <ListView x:Name="RowList" Grid.Row="1" Padding="8,4,8,8"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChecksumRow">
                                <Grid ColumnSpacing="12" Padding="8,4,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource LogText}"
                                               Text="{x:Bind Expected}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <FontIcon FontSize="13" Glyph="&#xE73E;"
                                                  Visibility="{x:Bind IsOk}" />
                                        <FontIcon FontSize="13" Glyph="&#xEA39;"
                                                  Visibility="{x:Bind IsMismatch}" />
                                        <FontIcon FontSize="13" Glyph="&#xE711;"
                                                  Visibility="{x:Bind IsMissing}" />
                                        <TextBlock Text="{x:Bind StatusText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Button x:Name="LogButton" Click="OnToggleLog" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="VerifyAgainButton" Click="OnVerifyAgain" Visibility="Collapsed" />
                <Button x:Name="CreateButton" Style="{StaticResource AccentButtonStyle}" Click="OnCreate" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
