<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain net8.0 ON PURPOSE, not net8.0-windows. Everything that is
         not pixels lives here or in Parfast.ViewModels, so both build and
         unit-test on macOS and Linux. Only Parfast.App needs a Windows
         host, which is what lets this lane make progress while the only
         WinUI-capable box on the fleet is busy with a bench round. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Parfast.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The posting set's RECORDED snapshots, real frames from the core, which
         MockPostingJob plays back. Embedded rather than copied beside the
         assembly so the mock cannot run without them and the tests need no
         path to the shared tree; linked from the shared folder so the mac app
         and this one replay the same bytes. -->
    <EmbeddedResource Include="..\..\shared\contract\posting-set-snapshots.json"
                      LogicalName="Parfast.Core.Mock.posting-set-snapshots.json"
                      Link="Mock\posting-set-snapshots.json" />
  </ItemGroup>
</Project>
