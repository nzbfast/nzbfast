<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  nzbfast daemon - macOS launchd agent (runs at login).
  Install:
    cp packaging/launchd/com.nzbfast.daemon.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.nzbfast.daemon.plist
  Edit the paths below first. Config at ~/.config/nzbfast/config.json.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nzbfast.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/nzbfast</string>
        <string>serve</string>
        <string>--config</string>
        <string>REPLACE_HOME/.config/nzbfast/config.json</string>
        <string>--port</string>
        <string>6789</string>
        <string>--out</string>
        <string>REPLACE_HOME/Downloads/nzbfast</string>
        <string>--watch</string>
        <string>REPLACE_HOME/Downloads/nzbfast/watch</string>
        <!--
          ABSOLUTE, because the flag defaults to a RELATIVE `index.db`
          and launchd gives an agent no working directory of its own
          choosing - so the built-in indexer's database landed wherever
          launchd happened to start us, or could not be created at all.
          Every other path this agent passes is already absolute; the
          index was the one that was not.
        -->
        <string>--index-db</string>
        <string>REPLACE_HOME/.config/nzbfast/index.db</string>
    </array>
    <!-- Belt for anything else that resolves a relative path. -->
    <key>WorkingDirectory</key>
    <string>REPLACE_HOME/.config/nzbfast</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>REPLACE_HOME/Library/Logs/nzbfast.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_HOME/Library/Logs/nzbfast.log</string>
</dict>
</plist>
