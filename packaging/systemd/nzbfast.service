# nzbfast daemon - systemd unit (Linux seedbox / home server).
# Install:
#   sudo cp target/release/nzbfast /usr/local/bin/
#   sudo useradd -r -s /usr/sbin/nologin nzbfast || true
#   sudo mkdir -p /etc/nzbfast /var/lib/nzbfast/downloads /var/lib/nzbfast/watch
#   sudo chmod 750 /etc/nzbfast
#   # config.json holds your provider username and password. `cp` would give
#   # it the example file's 0644 and leave it world-readable in a directory
#   # every local account can search; install it 0600 from the start.
#   sudo install -m600 -o nzbfast -g nzbfast packaging/config.example.json \
#        /etc/nzbfast/config.json  # then edit
#   sudo chown -R nzbfast:nzbfast /etc/nzbfast /var/lib/nzbfast
#   sudo cp packaging/systemd/nzbfast.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nzbfast
[Unit]
Description=nzbfast Usenet downloader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nzbfast
Group=nzbfast
# ProtectSystem=strict makes everything outside ReadWritePaths read-only, and
# systemd starts a service in `/`. Anything the daemon opens by a RELATIVE
# path therefore lands somewhere it cannot write: the built-in index defaults
# to `index.db`, and its lazy open paths swallow the error, so enabling
# indexing from the dashboard looked like a feature that just stays empty.
# Both halves are set here - the working directory for any future relative
# default, and the index path explicitly.
WorkingDirectory=/var/lib/nzbfast
ExecStart=/usr/local/bin/nzbfast serve \
    --config /etc/nzbfast/config.json \
    --port 6789 \
    --out /var/lib/nzbfast/downloads \
    --watch /var/lib/nzbfast/watch \
    --index-db /var/lib/nzbfast/index.db
Restart=on-failure
RestartSec=5

# Hardening - the daemon only needs its own data dirs.
# The spool holds the API key, provider credentials and job state, so keep
# anything the daemon creates owner-only rather than inheriting 0022.
#
# This reaches --out as well, and systemd has no per-path umask: finished
# downloads come out 0700/0600, so a Sonarr or Radarr running as another
# user cannot read them, nor rename them out of the folder holding them
# (issue #20). Do NOT relax this line to fix that - it also protects the
# generated API key. Set "Permissions on finished downloads" in Settings ->
# Disk & quota instead (`out_umask` in settings.json): 002 gives the output
# tree 775/664 and leaves everything else owner-only. Add the importing
# user to the nzbfast group, or run both under one group, and the import
# becomes a rename rather than a copy.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nzbfast /etc/nzbfast

[Install]
WantedBy=multi-user.target
