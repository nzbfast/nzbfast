# nzbfast daemon - systemd unit (Linux seedbox / home server).
# Install:
#   sudo cp target/release/nzbfast /usr/local/bin/
#   sudo useradd -r -s /usr/sbin/nologin nzbfast || true
#   sudo mkdir -p /etc/nzbfast /var/lib/nzbfast/downloads /var/lib/nzbfast/watch
#   sudo chmod 750 /etc/nzbfast
#   # config.json holds your provider username and password. `cp` would give
#   # it the example file's 0644 and leave it world-readable in a directory
#   # every local account can search; install it 0600 from the start.
#   sudo install -m600 -o nzbfast -g nzbfast packaging/config.example.json \
#        /etc/nzbfast/config.json  # then edit
#   sudo chown -R nzbfast:nzbfast /etc/nzbfast /var/lib/nzbfast
#   sudo cp packaging/systemd/nzbfast.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nzbfast
[Unit]
Description=nzbfast Usenet downloader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nzbfast
Group=nzbfast
# ProtectSystem=strict makes everything outside ReadWritePaths read-only, and
# systemd starts a service in `/`. Anything the daemon opens by a RELATIVE
# path therefore lands somewhere it cannot write: the built-in index defaults
# to `index.db`, and its lazy open paths swallow the error, so enabling
# indexing from the dashboard looked like a feature that just stays empty.
# Both halves are set here - the working directory for any future relative
# default, and the index path explicitly.
WorkingDirectory=/var/lib/nzbfast
ExecStart=/usr/local/bin/nzbfast serve \
    --config /etc/nzbfast/config.json \
    --port 6789 \
    --out /var/lib/nzbfast/downloads \
    --watch /var/lib/nzbfast/watch \
    --index-db /var/lib/nzbfast/index.db
Restart=on-failure
RestartSec=5

# Hardening - the daemon only needs its own data dirs.
# The spool holds the API key, provider credentials and job state, so keep
# anything the daemon creates owner-only rather than inheriting 0022.
#
# This reaches --out as well, and systemd has no per-path umask: finished
# downloads come out 0700/0600, so a Sonarr or Radarr running as another
# user cannot read them, nor rename them out of the folder holding them
# (issue #20). Do NOT relax this line to fix that - it also protects the
# generated API key. Set "Permissions on finished downloads" in Settings ->
# Disk & quota instead (`out_umask` in settings.json): 002 gives the output
# tree 775/664 and leaves everything else owner-only. Add the importing
# user to the nzbfast group, or run both under one group, and the import
# becomes a rename rather than a copy.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/nzbfast /etc/nzbfast

# ProtectHome is read-only rather than true, and that is a decision rather
# than a slip. `true` hides /home, /root and /run/user outright, which means
# a post-processing script living in the user's home directory cannot be
# read, let alone run, and a library filer cannot see a media tree under
# /home. Both of those are things the manual promises a confined script can
# do ("keeps full read access ... it may write only inside the folders
# nzbfast already uses"), so `true` made the packaged unit contradict the
# shipped behaviour of the subprocess confinement in
# `crates/nzbfast-core/src/sandbox.rs`. `read-only` is the systemd spelling
# of exactly the policy that module applies to a script: reads yes, writes
# no. The daemon keeps nothing under /home either way (config is in
# /etc/nzbfast, state in /var/lib/nzbfast), unix file permissions still
# apply on top of this, and the highest-risk children are not affected:
# `unrar` and `par2` run under the strict tool policy, whose bwrap sandbox
# re-denies every read outside the system prefixes and the job directory.
# If you would rather have the stronger setting, `ProtectHome=true` is safe
# so long as no script and no move-to destination lives under /home.
ProtectHome=read-only

# --- Hardening delta, TODO 314 stage 0 item 4 -------------------------
# From `research/SANDBOX-SCOPING-2026-08.md` section 3.3. Every line below
# was booted, not just written: the whole set was installed on an
# Ubuntu 24.04 host with systemd 255 and a real download was run through
# it. `systemd-analyze security nzbfast.service` reports the score.
#
# The daemon needs no capability at all once systemd has set its uid.
CapabilityBoundingSet=
AmbientCapabilities=
# Nothing here is a JIT, so W^X costs nothing and removes the shellcode
# step from any exploit of the one memory-unsafe component we ship (the
# rapidyenc SIMD kernels). Verified rather than assumed: a grep for
# PROT_EXEC / MAP_JIT / mprotect over `crates/` and `vendor/rars/src`
# returns nothing, and the RAR VM in `vendor/rars/src/codec/rarvm.rs` is an
# interpreter over a plain byte vector.
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
PrivateDevices=true
SystemCallArchitectures=native

# THREE directives in that list are AMENDED rather than taken verbatim,
# because the study's shape for them silently disables the subprocess
# confinement that landed the same week (TODO 314 stage 1). That module
# runs `unrar`, `par2` and your own scripts inside `bwrap`, and it PROBES
# its mechanism at startup: a bwrap that cannot run is not an error you
# see, it is a health row quietly reading "none available". Measured on the
# box named above, each of these three took the probe from pass to fail:
#
#   RestrictNamespaces=true
#       "bwrap: No permissions to create new namespace". bwrap needs a user
#       and a mount namespace to exist at all. The allow-list below names
#       exactly the five it uses, which still denies cgroup and pid.
#   RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
#       "bwrap: loopback: Failed to create NETLINK_ROUTE socket". Bringing
#       up loopback inside the child's own network namespace is what needs
#       AF_NETLINK. Adding it still denies AF_PACKET, AF_BLUETOOTH,
#       AF_VSOCK and the rest.
#   SystemCallFilter=@system-service, and ~@privileged on top of it
#       Killed by SIGSYS. @system-service does not carry @mount, so bwrap
#       loses pivot_root; and with SystemCallErrorNumber=EPERM to make it
#       speak, ~@privileged reports "bwrap: capset failed". A denied
#       syscall cannot be re-allowed by naming it, so @privileged comes
#       off the deny list; @resources and @obsolete stay, and the allow
#       list is doing most of that work already.
RestrictNamespaces=user mnt ipc uts net
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service @mount
SystemCallFilter=~@resources @obsolete

[Install]
WantedBy=multi-user.target
