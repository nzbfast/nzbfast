{
  "id": "/",
  "name": "nzbfast",
  "short_name": "nzbfast",
  "description": "A fast Usenet downloader: fetch, verify, repair and unpack in one pass, with a dashboard that shows what is happening while it happens.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0e1014",
  "theme_color": "#0e1014",
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screens/dash-wide.jpg", "sizes": "1280x800", "type": "image/jpeg", "form_factor": "wide", "label": "The nzbfast dashboard while a download runs" },
    { "src": "/screens/dash-narrow.jpg", "sizes": "390x844", "type": "image/jpeg", "form_factor": "narrow", "label": "The nzbfast dashboard on a phone" }
  ],
  "file_handlers": [
    { "action": "/", "accept": { "application/x-nzb": [".nzb"] } }
  ],
  "shortcuts": [
    { "name": "Settings", "url": "/#settings" }
  ]
}
