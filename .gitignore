.DS_Store
/target
# The parfast desktop GUI's DETACHED cargo workspace builds into its own
# target directory (decision D2a - apps/parfast/Cargo.toml's header).
# `/target` above is anchored at the repo root, so it does not reach
# this one, and a workspace nothing ignores would have staged 3 GB of
# artefacts on its first commit.
/apps/parfast/target
*.log
# ...but NOT a research run log. A benchmark round's per-run stderr IS the
# evidence its write-up cites, and this rule used to eat it: `git add <dir>`
# staged those logs as nothing, silently, and a published round lost the
# files it named. Scope stays research/ on purpose - bench/ exports, and its
# logs must keep being ignored.
!research/**/*.log
# ...nor a log PUBLISHED on the site. website/parfast-bench/ is the evidence
# behind website/parfast-benchmarks.html, whose lead says every log is
# published beside it, and `*.log` above would have staged 90 of its 98 files
# as nothing at all - the same silent eat the comment above records, one
# directory over. These are scrubbed copies written by
# website/tools/export_parfast_evidence.py; the originals under research/ are
# what a round is banked as.
!/website/parfast-bench/**/*.log

# Local prototype config with server credentials - never commit
config.local.json

# Swift app build artifacts
macapp/.build/
macapp/build/
# parfast desktop GUI (apps/parfast/mac): SwiftPM's cache, the assembled
# .app, and the icon master the bundle script draws at build time.
apps/parfast/mac/.build/
apps/parfast/mac/build/
# The universal staticlib make-app.sh lipos out of the detached cargo
# workspace, and that workspace's own target dir.
apps/parfast/mac/vendor/
apps/parfast/target/
# iOS spike harness bundle (built by packaging/ios/build-harness.sh)
packaging/ios/NZBFastHarness.app/

# Runtime SQLite index + WAL sidecars (churn every daemon run)
*.db
*.db-shm
*.db-wal

# Daemon runtime output / spool
/downloads/
/watch/
/ddash/
.spool/

# Bundle build output
/dist/
# ...and the two per-product dist directories. packaging/build-parfast-
# bundles.sh has defaulted to /dist-parfast/ since it landed and nothing
# ignored it, so a lane that built the CLI assets saw them as untracked
# files in `git status` on a shared checkout - which is how an asset gets
# staged by accident. The GUI script's default is listed beside it.
/dist-parfast/
/dist-parfast-gui/
/packaging/*/nzbfast-*-getting-started.pdf

# daemon runtime settings (written by the dashboard) + the persist
# layer's crash-safety siblings
settings.json
packaging/windows/stage/
packaging/windows/out/
packaging/mac/build/
# .deb / .rpm built by packaging/linux/make-packages.sh
packaging/linux/out/
settings.json.bak
settings.json.corrupt
# a bare key dumped out of settings.json to talk to a local daemon -
# the one file in this list that is a live credential on its own
apikey

# field-repro NZBs (real message-ids - never publish)
repro-nzbs/

# update-signing private key, should a rotation ever drop one. Offline
# secret - must never be committed.
docs/ROTATE-KEY-SECRET.txt

# config backups can hold provider credentials (same reason
# config.local.json above is ignored); conntune output + local agent
# tooling scratch are per-machine artifacts, never repo content.
config.local.json.bak
conntune.json
.agents/

# generated by tools/stage-manual.py from docs/MANUAL*.html for the website copy
website/MANUAL.html
website/MANUAL.*.html

# daemon runtime state at the repo root (the dev daemon runs from the
# checkout; siblings config.local.json/settings.json are ignored above)
runtime.json

# the archive-password list the extractor reads, at the repo root only.
# It is user content - real passwords for real posts - and the dev daemon
# writes one here whenever it runs from the checkout. Root-anchored so a
# committed test fixture of the same name stays possible.
/passwords.txt

# per-machine editor launch config + agent worktrees (worktrees
# were only in .git/info/exclude before, which a fresh clone loses)
.claude/launch.json
.claude/worktrees/
# ...but the agent-session build env IS repo content, and the bare
# `settings.json` rule above (daemon runtime settings) matches at every
# depth, so it swallows this file too. Negated by exact path: the daemon
# rule is untouched, and `.claude/` itself is not excluded, so git can
# still reach in. It pins CARGO_INCREMENTAL and the dev debuginfo level
# for agent sessions, which otherwise fill the disk with artifact
# variants cargo never collects. `.claude/settings.local.json` stays
# ignored - that one is per-machine.
!.claude/settings.json

# CPython bytecode caches. The repo's python tooling runs from inside
# the checkout - the repo-root gates (size, lock, doc, ref, par2,
# provenance, leg-warn) and the per-session .claude/tools hooks - and
# CPython drops a __pycache__/ next to whichever script it imported.
# The session hook fires on EVERY session in EVERY worktree, so before
# this rule landed `git status` opened with an untracked directory in
# every lane, which is exactly the noise a shared checkout cannot
# afford when the rule is "stage by explicit path". Repo-wide rather
# than one path: two of those gates ship publicly, so a public
# contributor running them lands in the same place.
__pycache__/
*.pyc

# merge debris and editor state
*.orig
*.rej
.vscode/
.idea/
.scan-stamps

# Torture-soak corpora: built by make_adversarial*.sh / fetch_fixtures*.sh,
# large (round 4's is 1.5 GB with its 1 GiB advYA payload) and disposable.
# The generators and the ground-truth manifests are what get committed.
research/torture-soak-2026-08-11/adversarial*/
research/torture-soak-2026-08-11/fixtures*/

# tools/checkjs-gate.py's pinned typescript, installed by `npm ci` from the
# committed package.json + package-lock.json. Dev-only and nothing here
# ships - see the gate's header for why the pin is exact.
/node_modules/

# research/stage-roundbook-logs.sh copies five banked round logs to the flat
# names research/extract.py reads them under. They are COPIES: the banked path
# under research/rounds/ is the one committed, and a second copy in git would
# be the shape where the two drift and nobody can say which the page was built
# from. Re-make them with that script, never by committing them.
/research/i5full.log
/research/zfull.log
/research/m5full.log
/research/mswp.log
/research/zswp2.log
